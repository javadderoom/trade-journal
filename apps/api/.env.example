# ─── Vercel Environment Variables for TradeKav Backend (apps/api) ─────
# Configure these in your Vercel Project Settings for "tradekav-api"

# ─── Database (PostgreSQL) ──────────────────────────────────────────
# Point to your pooled PostgreSQL database (e.g., Supabase, Neon, or your VPS)
DATABASE_URL="postgresql://user:password@host:5432/trade_journal?schema=public&pgbouncer=true"

# ─── Auth ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="your_64_char_hex_secret_here"
JWT_ACCESS_EXPIRES_IN="15m"

# ─── Encryption ─────────────────────────────────────────────────────
# 64-char hex string for AES-256-GCM.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_ENCRYPTION_KEY="your_64_char_hex_key_here"

# ─── CORS & Domain ──────────────────────────────────────────────────
CORS_ORIGINS="https://tradekav.ir,https://www.tradekav.ir"
FRONTEND_URL="https://tradekav.ir"
NODE_ENV="production"

# ─── Optional Integrations ──────────────────────────────────────────
# Redis (Optional or Upstash Redis for serverless cache)
# REDIS_URL="redis://default:password@host:6379"

# SMS (Kavenegar)
KAVENEGAR_API_KEY=""
KAVENEGAR_OTP_TEMPLATE=""

# Payment: PayPing / ZarinPal
PAYPING_TOKEN=""
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="false"
MOCK_PAYMENT="false"

# Email (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="TradeKav <noreply@tradekav.ir>"

# Market Data & AI
TWELVEDATA_API_KEY=""
AI_AUTOMATION_CRON_SECRET=""
