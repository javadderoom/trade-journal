# Vercel Environment Variables for TradeKav Frontend (apps/web)
# Set these in Vercel Project Settings -> Environment Variables

# Backend API base URL (Points to your backend deployed on api.tradekav.ir)
NEXT_PUBLIC_API_BASE_URL=https://api.tradekav.ir
NEXT_PUBLIC_API_URL=https://api.tradekav.ir

# Frontend Web Application URL
NEXT_PUBLIC_WEB_URL=https://tradekav.ir

# Optional Google Analytics measurement ID
NEXT_PUBLIC_GA_ID=G-T2148XPMH9
